# Copy to .env and fill in only the providers you use. .env is gitignored; CI reads the same names from
# repository secrets. Every key is optional: offline tests and the local Ollama path need none.
OPENAI_API_KEY=
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Hugging Face token: only needed if dataset downloads are rate-limited.
HF_TOKEN=
# Local OpenAI-compatible server (Ollama default shown; vLLM: http://localhost:8000/v1)
OLLAMA_BASE_URL=http://localhost:11434/v1
