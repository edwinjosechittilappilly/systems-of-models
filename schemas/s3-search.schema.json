{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/edwinjosechittilappilly/systems-of-models/main/schemas/s3-search.schema.json",
  "title": "Search system (S3) contract, major version 1",
  "description": "Several candidate trajectories, an external verifier that scores them, and an explicit selection rule. Covers best-of-N with a reward model, self-consistency voting, beam search, Tree of Thoughts and Monte Carlo tree search over model outputs.",
  "type": "object",
  "properties": {
    "request": { "$ref": "#/$defs/request" },
    "response": { "$ref": "#/$defs/response" }
  },
  "anyOf": [{ "required": ["request"] }, { "required": ["response"] }],
  "$defs": {
    "verifier_kind": {
      "enum": [
        "outcome_reward_model",
        "process_reward_model",
        "unit_tests",
        "formal_checker",
        "llm_judge",
        "s1_decision",
        "majority_vote",
        "simulator"
      ]
    },
    "request": {
      "type": "object",
      "required": ["input", "strategy", "generator", "verifier", "selection", "budget"],
      "properties": {
        "input": { "$ref": "envelope.schema.json#/$defs/input" },
        "strategy": {
          "enum": ["best_of_n", "self_consistency", "beam", "tree_of_thoughts", "mcts", "evolutionary"]
        },
        "generator": {
          "type": "object",
          "description": "Produces candidates; usually an S2 contract.",
          "required": ["system"],
          "properties": {
            "system": { "$ref": "envelope.schema.json#/$defs/system_id" },
            "model": { "type": "string" },
            "branching_factor": { "type": "integer", "minimum": 1 },
            "max_depth": { "type": "integer", "minimum": 1 },
            "temperature": { "type": "number", "minimum": 0 },
            "reasoning_effort": { "$ref": "s2-reasoning.schema.json#/$defs/effort" }
          }
        },
        "verifier": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "$ref": "#/$defs/verifier_kind" },
            "ref": {
              "type": "string",
              "description": "Model ID, test-suite URI, checker name, or the name of an S1 question set."
            },
            "granularity": { "enum": ["outcome", "step"], "default": "outcome" },
            "accept_threshold": { "type": "number", "description": "Score at or above which a candidate passes." }
          }
        },
        "selection": {
          "type": "object",
          "required": ["rule"],
          "properties": {
            "rule": { "enum": ["argmax", "majority", "first_passing", "weighted_vote", "pareto"] },
            "k": { "type": "integer", "minimum": 1, "default": 1, "description": "Number of candidates to return." },
            "min_margin": { "type": "number", "minimum": 0, "description": "Escalate when the top-two score gap is below this." }
          }
        },
        "budget": {
          "type": "object",
          "properties": {
            "max_candidates": { "type": "integer", "minimum": 1 },
            "max_expansions": { "type": "integer", "minimum": 1 },
            "max_cost": { "type": "number", "minimum": 0 },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "max_latency_ms": { "type": "number", "minimum": 0 }
          },
          "anyOf": [
            { "required": ["max_candidates"] },
            { "required": ["max_expansions"] },
            { "required": ["max_cost"] },
            { "required": ["max_latency_ms"] }
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["verifier", "score"],
      "properties": {
        "verifier": { "$ref": "#/$defs/verifier_kind" },
        "score": { "type": "number" },
        "passed": { "type": "boolean" },
        "step_scores": { "type": "array", "items": { "type": "number" } },
        "evidence": { "type": "string", "description": "Verifier output, e.g. failing test names." },
        "response_id": { "type": "string", "description": "Envelope ID when the verifier is itself a system (e.g. S1)." }
      }
    },
    "candidate": {
      "type": "object",
      "required": ["id", "content", "status"],
      "properties": {
        "id": { "type": "string" },
        "parent_id": { "type": ["string", "null"] },
        "depth": { "type": "integer", "minimum": 0 },
        "content": { "description": "Candidate answer or partial trajectory (string or structured)." },
        "generator_response_id": { "type": "string" },
        "verification": { "$ref": "#/$defs/verification" },
        "visits": { "type": "integer", "minimum": 0, "description": "MCTS visit count." },
        "status": { "enum": ["open", "expanded", "pruned", "terminal", "selected"] }
      }
    },
    "body": {
      "type": "object",
      "required": ["candidates", "selection", "answer", "search_stats"],
      "properties": {
        "candidates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/candidate" } },
        "selection": {
          "type": "object",
          "required": ["rule", "selected_ids"],
          "properties": {
            "rule": { "$ref": "#/$defs/request/properties/selection/properties/rule" },
            "selected_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "margin": { "type": "number", "description": "Score gap between the best and the runner-up." },
            "rationale": { "type": "string" }
          }
        },
        "answer": { "description": "Content of the selected candidate(s)." },
        "search_stats": {
          "type": "object",
          "required": ["candidates_generated", "terminated_by"],
          "properties": {
            "candidates_generated": { "type": "integer", "minimum": 0 },
            "candidates_verified": { "type": "integer", "minimum": 0 },
            "expansions": { "type": "integer", "minimum": 0 },
            "max_depth_reached": { "type": "integer", "minimum": 0 },
            "pruned": { "type": "integer", "minimum": 0 },
            "terminated_by": { "enum": ["budget", "accept_threshold", "exhausted", "escalated"] }
          }
        }
      }
    },
    "response": {
      "allOf": [
        { "$ref": "envelope.schema.json" },
        {
          "properties": {
            "system": { "const": "s3.search" },
            "system_version": { "pattern": "^1\\." },
            "body": { "$ref": "#/$defs/body" }
          }
        }
      ]
    }
  }
}
